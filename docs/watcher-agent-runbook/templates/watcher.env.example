# Copy this file to a project-specific location and fill every required value.

# Haskell watcher repository checkout.
WATCHER_REPO=/workspace/artifacts/codex-watcher-hs

# Haskell toolchain policy: ghcup should manage both ghc and cabal.
HASKELL_TOOLCHAIN_MANAGER=ghcup

# Compiled watcher executable. Prefer cabal list-bin after build:
#   cd "$WATCHER_REPO" && WATCHER_BIN=$(cabal list-bin moifold)
WATCHER_BIN=/workspace/artifacts/codex-watcher-hs/dist-newstyle/build/aarch64-linux/ghc-9.12.2/moifold-0.1.0.0/x/moifold/build/moifold/moifold

# Target GitHub project.
REPO_FULL_NAME=owner/name
PROJECT_KEY=owner_name
TARGET_WORKDIR=/workspace/artifacts/name-workdir

# App-server endpoint used by the watcher to create/read threads and turns.
# This service must be running before execute loops can start useful work.
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=4500
APP_SERVER_PATH=/

# Dependency setup policy. Keep false for default check-only behavior.
# Operators may run scripts/watcher-init/check-project-setup.sh /path/to/watcher.env --install after reviewing suggested commands.
ALLOW_DEPENDENCY_INSTALL=false

# State roots.
STATE_ROOT=/workspace/artifacts
PLANNER_STATE_DIR=/workspace/artifacts/issue-planners/owner__name
IMPLEMENTERS_ROOT=/workspace/artifacts/issue-implementers
PR_REVIEW_ROOT=/workspace/artifacts/pr-review-watchers
ISSUE_WORKDIR_ROOT=/workspace/artifacts/issue-workdirs

# Defaults for issue implementer children.
BRANCH_PREFIX=codex/issue-
THREAD_PREFIX=issue-worker-
POLL_SECONDS=30
MAX_PARALLEL=3

# Fill for specific watcher operations.
ISSUE_NUMBER=123
PR_NUMBER=456
ISSUE_BRANCH=codex/issue-123
WORKER_THREAD_ID=issue-worker-123
REVIEWER_THREAD_ID=reviewer-456
PLANNER_THREAD_ID=planner-owner-name
