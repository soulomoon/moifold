# Copy this file to a project-specific location and fill every required value.

# Persistent Docker container used for all watcher and target-project setup commands.
WATCHER_DOCKER_CONTAINER=moifold-watcher

# Haskell watcher repository checkout as seen inside the persistent container.
WATCHER_REPO=/work/moifold

# Haskell toolchain policy: ghcup should manage both ghc and cabal.
HASKELL_TOOLCHAIN_MANAGER=ghcup

# Compiled watcher executable. Resolve during moifold setup:
#   cd "$WATCHER_REPO" && cabal update && cabal build all && WATCHER_BIN=$(cabal list-bin moifold)
WATCHER_BIN=

# Target GitHub project as seen inside the persistent container.
REPO_FULL_NAME=owner/name
TARGET_WORKDIR=/workspace/artifacts/name-workdir

# App-server endpoint used by the watcher to create/read threads and turns.
# Run app-server inside the persistent watcher container so TARGET_WORKDIR paths are valid for both watcher and app-server.
# If an operator deliberately runs app-server on the host instead, use host.docker.internal on Docker Desktop and ensure cwd path mapping is handled.
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=4500
APP_SERVER_PATH=/
# Default protocol mode verifies the WebSocket initialize handshake.
# Docker smoke uses tcp mode with a mock listener because it does not start a real Codex app-server.
APP_SERVER_CHECK_MODE=protocol
# Optional live probes. Creating a smoke turn can consume model resources.
APP_SERVER_CREATE_SMOKE_THREAD=false
APP_SERVER_START_SMOKE_TURN=false
# Optional existing thread to verify thread/read.
APP_SERVER_PROBE_THREAD_ID=
# Operator-specific command for starting app-server when it is not already running.
# Normal operation starts this during moifold setup inside the persistent container.
APP_SERVER_START_COMMAND="cd /workspace/artifacts && codex app-server --listen ws://127.0.0.1:4500"

# Dependency setup policy. Keep false for default check-only behavior.
# Run scripts/watcher-init/check-project-setup.sh /path/to/watcher.env --install to execute detected setup commands.

# State roots.
STATE_ROOT=/workspace/artifacts
PLANNER_STATE_DIR=/workspace/artifacts/issue-planners/owner_name
IMPLEMENTERS_ROOT=/workspace/artifacts/issue-implementers
PR_REVIEW_ROOT=/workspace/artifacts/pr-review-watchers
ISSUE_WORKDIR_ROOT=/workspace/artifacts/issue-workdirs

# Defaults for issue implementer children.
BRANCH_PREFIX=codex/issue-
THREAD_PREFIX=issue-worker-
POLL_SECONDS=30
MAX_PARALLEL=3

# Fill for specific watcher operations.
ISSUE_NUMBER=123
PR_NUMBER=456
ISSUE_BRANCH=codex/issue-123
ISSUE_WORKER_THREAD_ID=issue-worker-123
PR_WORKER_THREAD_ID=pr-worker-456
PR_REVIEWER_THREAD_ID=pr-reviewer-456
PLANNER_THREAD_ID=planner-owner-name
