cabal-version: 3.8
name:          agent-workflow-github
version:       0.1.0.0
synopsis:      GitHub identifiers, remote metadata, and command specs
description:
  Reusable GitHub identifiers, remote metadata parsing, and pure gh/git command
  rendering helpers. Lifecycle policy, command execution, healthcheck, PR and
  issue workflow decisions, merge and review publication policy, compatibility
  facades, package upload, and source-distribution decisions remain outside
  this reusable package candidate.
license:       MIT
author:        soulomoon
maintainer:    soulomoon
category:      Development
build-type:    Simple
extra-doc-files:
  README.md

source-repository head
  type:     git
  location: https://github.com/soulomoon/moifold.git

flag development-werror
  description: Enable -Werror for local development builds.
  manual:      True
  default:     False

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints

  if flag(development-werror)
    ghc-options:
      -Werror

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    CodexWatcher.Workflow.GitHub.Command
    CodexWatcher.Workflow.GitHub.Ids
    CodexWatcher.Workflow.GitHub.Remote
  build-depends:
    aeson >=2.2 && <3,
    base >=4.18 && <5,
    text >=2.0 && <3
  default-language: GHC2021
