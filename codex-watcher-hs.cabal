cabal-version: 3.8
name:          codex-watcher-hs
version:       0.1.0.0
synopsis:      Type-level Codex watcher state machine core
description:   Haskell-first rewrite of Codex watcher orchestration with type-level lifecycle invariants.
license:       MIT
author:        soulomoon
maintainer:    soulomoon
category:      Development
build-type:    Simple

source-repository head
  type:     git
  location: https://github.com/soulomoon/codex-watcher-hs.git

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints
    -Werror

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    CodexWatcher.ActionExecutor
    CodexWatcher.AppServerClient
    CodexWatcher.AppServerProtocol
    CodexWatcher.AutomaticLoopCli
    CodexWatcher.ChildDaemon
    CodexWatcher.Cli
    CodexWatcher.CliPaths
    CodexWatcher.CompatibilityRuntime
    CodexWatcher.CompatibilityState
    CodexWatcher.Daemon
    CodexWatcher.DaemonControlCli
    CodexWatcher.DaemonLoop
    CodexWatcher.DaemonLoop.Runtime
    CodexWatcher.DaemonLoop.Types
    CodexWatcher.EffectInterpreter
    CodexWatcher.EffectRuntimeCli
    CodexWatcher.Effects
    CodexWatcher.EventLog
    CodexWatcher.EventLogRepair
    CodexWatcher.GhGit
    CodexWatcher.GoldenReplay
    CodexWatcher.Healthcheck
    CodexWatcher.Healthcheck.Analysis
    CodexWatcher.Healthcheck.Types
    CodexWatcher.IssueFanoutCli
    CodexWatcher.IssueText
    CodexWatcher.IssueImplementationLoop
    CodexWatcher.IssuePlanningFanout
    CodexWatcher.IssueImplementWatcher
    CodexWatcher.IssuePlanningWatcher
    CodexWatcher.Json
    CodexWatcher.JsonPath
    CodexWatcher.Logging
    CodexWatcher.Observation
    CodexWatcher.ObserveCli
    CodexWatcher.PlanningLoop
    CodexWatcher.PlanningGraphCanonical
    CodexWatcher.Protocol
    CodexWatcher.PromptTemplates
    CodexWatcher.PrReviewLaunchCli
    CodexWatcher.PrReviewLoop
    CodexWatcher.PrReviewWatcher
    CodexWatcher.ReplayCli
    CodexWatcher.Runtime
    CodexWatcher.Runtime.Json
    CodexWatcher.RuntimeOwner
    CodexWatcher.RuntimeOwnerCli
    CodexWatcher.RuntimeDefaults
    CodexWatcher.RunnerGuard
    CodexWatcher.RunnerGuardCli
    CodexWatcher.Snapshot
    CodexWatcher.ServiceCli
    CodexWatcher.StateMachine
    CodexWatcher.Supervisor
    CodexWatcher.TurnOutput
    CodexWatcher.Types
    CodexWatcher.TurnClassifier
    CodexWatcher.WatcherLiveness
    CodexWatcher.WatcherPaths
    CodexWatcher.WatcherRuntimeStatus
  build-depends:
    aeson >=2.2 && <3,
    base >=4.18 && <5,
    bytestring >=0.12 && <0.13,
    co-log-core >=0.3.2.6 && <0.4,
    containers >=0.6 && <0.9,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    optparse-applicative >=0.18 && <0.20,
    time >=1.12 && <1.15,
    text >=2.0 && <3,
    typed-process >=0.2 && <0.3,
    unix >=2.8 && <2.9,
    websockets >=0.13 && <0.14
  default-language: GHC2021

executable codex-watcher-hs
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    base >=4.18 && <5,
    codex-watcher-hs
  default-language: GHC2021

test-suite watcher-core-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test, app
  main-is:          Main.hs
  other-modules:
    AppServerSpec
    CliSpec
    GhGitSpec
    HealthcheckSpec
    JsonPathSpec
    RuntimeSpec
  build-depends:
    aeson >=2.2 && <3,
    base >=4.18 && <5,
    bytestring >=0.12 && <0.13,
    co-log-core >=0.3.2.6 && <0.4,
    codex-watcher-hs,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <3,
    text >=2.0 && <3,
    time >=1.12 && <1.15,
    unix >=2.8 && <2.9
  default-language: GHC2021
