cabal-version: 3.8
name:          moifold
version:       0.1.0.0
synopsis:      Type-level Codex watcher state machine core
description:   Haskell-first rewrite of Codex watcher orchestration with type-level lifecycle invariants.
license:       MIT
author:        soulomoon
maintainer:    soulomoon
category:      Development
build-type:    Simple

source-repository head
  type:     git
  location: https://github.com/soulomoon/moifold.git

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints
    -Werror

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    CodexWatcher.ActionExecutor
    CodexWatcher.AppServerClient
    CodexWatcher.AppServerProtocol
    CodexWatcher.AutomaticLoop.Runner
    CodexWatcher.ChildDaemon
    CodexWatcher.Cli.Command.DaemonControl
    CodexWatcher.Cli.Command.IssueFanout
    CodexWatcher.Cli.Command.Observe
    CodexWatcher.Cli.Command.Replay
    CodexWatcher.Cli.Command.RunnerGuard
    CodexWatcher.Cli.Command.Service
    CodexWatcher.Cli.Parser
    CodexWatcher.Cli.RuntimeConfig
    CodexWatcher.Cli.Types
    CodexWatcher.Core.Ids
    CodexWatcher.Core.Kinds
    CodexWatcher.Core.Limits
    CodexWatcher.Core.Reason
    CodexWatcher.Core.State
    CodexWatcher.Core.Thread
    CodexWatcher.Daemon
    CodexWatcher.DaemonLoop
    CodexWatcher.DaemonLoop.ActiveTurn
    CodexWatcher.DaemonLoop.Runtime
    CodexWatcher.DaemonLoop.TurnStart
    CodexWatcher.DaemonLoop.Types
    CodexWatcher.Domain.IssueImplement.Loop
    CodexWatcher.Domain.IssueImplement.TurnClassifier
    CodexWatcher.Domain.IssueImplement.Types
    CodexWatcher.Domain.IssueImplement.Watcher
    CodexWatcher.Domain.IssuePlanning.Fanout
    CodexWatcher.Domain.IssuePlanning.Graph.Canonical
    CodexWatcher.Domain.IssuePlanning.Loop
    CodexWatcher.Domain.IssuePlanning.Scope
    CodexWatcher.Domain.IssuePlanning.TurnClassifier
    CodexWatcher.Domain.IssuePlanning.Types
    CodexWatcher.Domain.IssuePlanning.Watcher
    CodexWatcher.Domain.PrReview.LaunchCli
    CodexWatcher.Domain.PrReview.Loop
    CodexWatcher.Domain.PrReview.Protocol
    CodexWatcher.Domain.PrReview.TurnClassifier
    CodexWatcher.Domain.PrReview.Types
    CodexWatcher.Domain.PrReview.Watcher
    CodexWatcher.EffectInterpreter
    CodexWatcher.Effects
    CodexWatcher.EventLog.File
    CodexWatcher.EventLog.Replay
    CodexWatcher.EventLog.Types
    CodexWatcher.EventLogRepair
    CodexWatcher.Failure
    CodexWatcher.GhGit
    CodexWatcher.GoldenReplay
    CodexWatcher.Healthcheck
    CodexWatcher.Healthcheck.Analysis
    CodexWatcher.Healthcheck.Types
    CodexWatcher.IssueText
    CodexWatcher.Json
    CodexWatcher.JsonPath
    CodexWatcher.Logging
    CodexWatcher.Observation
    CodexWatcher.PromptTemplates
    CodexWatcher.Runtime.BlockedState
    CodexWatcher.Runtime.Command.Render
    CodexWatcher.Runtime.Command.Types
    CodexWatcher.Runtime.Compatibility
    CodexWatcher.Runtime.Json
    CodexWatcher.Runtime.Defaults
    CodexWatcher.Runtime.File
    CodexWatcher.Runtime.Interpreter
    CodexWatcher.Runtime.Owner.Cli
    CodexWatcher.Runtime.Owner.Store
    CodexWatcher.Runtime.Owner.Types
    CodexWatcher.Runtime.Paths
    CodexWatcher.Runtime.Process
    CodexWatcher.Runtime.WatcherPaths
    CodexWatcher.RunnerGuard
    CodexWatcher.Snapshot
    CodexWatcher.StateMachine
    CodexWatcher.Supervisor
    CodexWatcher.Turn.Classifier.Common
    CodexWatcher.TurnOutput
    CodexWatcher.WatcherLiveness
    CodexWatcher.WatcherRuntimeStatus
  other-modules:
    CodexWatcher.AutomaticLoop.IssuePlanningFanout
    CodexWatcher.AutomaticLoop.Output
    CodexWatcher.AutomaticLoop.PrReviewHandoff
    CodexWatcher.AutomaticLoop.StartupThreads
    CodexWatcher.Cli.Parser.Common
    CodexWatcher.Cli.Parser.Fanout
    CodexWatcher.Cli.Parser.Guard
    CodexWatcher.Cli.Parser.Healthcheck
    CodexWatcher.Cli.Parser.Loop
    CodexWatcher.Cli.Parser.Observe
    CodexWatcher.Cli.Parser.Repair
    CodexWatcher.Cli.Parser.Service
  build-depends:
    aeson >=2.2 && <3,
    base >=4.18 && <5,
    bytestring >=0.12 && <0.13,
    co-log-core >=0.3.2.6 && <0.4,
    containers >=0.6 && <0.9,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    optparse-applicative >=0.18 && <0.20,
    singletons >=3.0 && <4,
    singletons-th >=3.5 && <3.6,
    time >=1.12 && <1.15,
    text >=2.0 && <3,
    typed-process >=0.2 && <0.3,
    unix >=2.8 && <2.9,
    websockets >=0.13 && <0.14
  default-language: GHC2021

executable moifold
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    base >=4.18 && <5,
    moifold
  default-language: GHC2021

test-suite watcher-core-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test, app
  main-is:          Main.hs
  other-modules:
    AppServerSpec
    CliSpec
    GhGitSpec
    HealthcheckSpec
    JsonPathSpec
    RuntimeSpec
  build-depends:
    aeson >=2.2 && <3,
    base >=4.18 && <5,
    bytestring >=0.12 && <0.13,
    co-log-core >=0.3.2.6 && <0.4,
    moifold,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <3,
    text >=2.0 && <3,
    time >=1.12 && <1.15,
    unix >=2.8 && <2.9
  default-language: GHC2021
