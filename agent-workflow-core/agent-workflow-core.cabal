cabal-version: 3.8
name:          agent-workflow-core
version:       0.1.0.0
synopsis:      Typed workflow kernel, replay, and effect plans
description:
  Generic workflow kernel contracts for specs, replay, codecs, event-log cores,
  effect plans, permissions, transactions, audit, daemon projections, and
  reusable failure classification. Concrete moifold event schemas, lifecycle
  policy, filesystem/runtime ownership, healthcheck, repair, and publication
  decisions remain outside this reusable package candidate.
license:       MIT
author:        soulomoon
maintainer:    soulomoon
category:      Development
build-type:    Simple
extra-doc-files:
  README.md

source-repository head
  type:     git
  location: https://github.com/soulomoon/moifold.git

flag development-werror
  description: Enable -Werror for local development builds.
  manual:      True
  default:     False

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints

  if flag(development-werror)
    ghc-options:
      -Werror

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    CodexWatcher.Workflow.Audit
    CodexWatcher.Workflow.Codec
    CodexWatcher.Workflow.Daemon.Core
    CodexWatcher.Workflow.DSL
    CodexWatcher.Workflow.EventLog.Commit.Core
    CodexWatcher.Workflow.EventLog.Core
    CodexWatcher.Workflow.EventLog.File.Core
    CodexWatcher.Workflow.Execution.Core
    CodexWatcher.Workflow.Failure
    CodexWatcher.Workflow.Indexed.Spec
    CodexWatcher.Workflow.Permission.Core
    CodexWatcher.Workflow.Spec
    CodexWatcher.Workflow.Transaction.Core
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.12 && <0.13,
    text >=2.0 && <3
  default-language: GHC2021
